# Sin valores reales. Los secretos entran solo por entorno.
AGENT_ENV=mock                 # mock | dev | prod  (elige config/<env>.yaml)

# Quien llama a la API (X-API-Key). El asesor siempre se autentica.
AGENT_CLIENT_API_KEY=
ADVISOR_API_KEY=

# Persistencia (dev/prod)
MONGO_URI=
MONGO_DB=auto_equity
PROVIDERS_BASE_URL=            # vacio = motor de mocks en proceso
AUDIT_PATH=reports/audit.jsonl

# LLM: scripted | openai | azure | deepseek | gemini | anthropic | cadena: gemini,openai
POLICY=rules                   # rules | llm
LLM_BACKEND=scripted
LLM_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_TIMEOUT_SEC=
